# Base URL of Moreno.API. Leave empty to use relative requests (works in dev via
# the Vite proxy at /api and /up, and in prod when the SPA is served from the
# same origin as the API).
# VITE_API_URL=https://api.moreno.land

# Dev-only: target the Vite proxy forwards /api and /up to. Defaults to
# http://localhost:5000 (Moreno.API's port).
# VITE_API_TARGET=http://localhost:5000
